{
  "translation": "BurJudson: 1835 Judson Burmese Bible",
  "language": "burmese",
  "dir": "ltr",
  "bookName": "Psalms",
  "bookSlug": "psalms",
  "nativeName": "Psalms",
  "chapterNumber": 113,
  "totalVerses": 9,
  "verses": [
    {
      "verse": 1,
      "text": "ထာဝရဘုရား၏ ကျွန်တော်တို့၊ ထာဝရဘုရား ၏နာမတော်ကို ချီးမွမ်းကြလော့။ ချီးမွမ်းကြလော့။"
    },
    {
      "verse": 2,
      "text": "ထာဝရဘုရား၏ နာမတော်သည် ယခုမှစ၍၊ အစဉ်အဆက် မင်္ဂလာရှိစေသတည်း။"
    },
    {
      "verse": 3,
      "text": "နေထွက်ရာမှသည် နေဝင်ရာတိုင်အောင်၊ ထာဝရဘုရား၏နာမတော်သည် ချီးမွမ်းဘွယ်ဖြစ်၏။"
    },
    {
      "verse": 4,
      "text": "ထာဝရဘုရားသည် လူမျိုးတကာတို့ အပေါ်၌၎င်း၊ ဘုန်းတော်သည် ကောင်းကင်အပေါ်၌၎င်း မြင့်တော်မူ၏။"
    },
    {
      "verse": 5,
      "text": "ကိုယ်ကို ချီးမြှင့်၍ ကျိန်းဝပ်တော်မူသော်လည်း၊"
    },
    {
      "verse": 6,
      "text": "ကိုယ်ကိုနှိမ့်ချ၍ ကောင်းကင်အရာနှင့် မြေကြီး အရာတို့ကို ကြည့်ရှုတော်မူသော ငါတို့၏ ဘုရားသခင် ထာဝရဘုရားနှင့် အဘယ်သူ တူသနည်း။"
    },
    {
      "verse": 7,
      "text": "ဆင်းရဲသောသူကို မြေမှုန့်ထဲကကြွလျက်၊ ငတ်မွတ်သော သူကို နောက်ချေးပုံထဲက ချီးမြှောက်လျက်၊"
    },
    {
      "verse": 8,
      "text": "မင်းသားတို့တွင်၎င်း၊ မိမိလူတို့ကို အုပ်စိုးသော မင်းတို့တွင်၎င်း နေရာပေးတော်မူ၏။"
    },
    {
      "verse": 9,
      "text": "မြုံနေသောမိန်းမသည် အိမ်၌နေ၍၊ဝမ်းမြောက် သောစိတ်နှင့် သားဘွားရသော အခွင့်ကို ပေးတော်မူ၏။ ဟာလေလုယ။"
    }
  ]
}