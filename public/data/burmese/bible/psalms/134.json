  "verses": [
    {
      "verse": 1,
      "text": "ထာဝရဘုရား၏ အိမ်တော်၌ ညဉ့်ယံစောင့် သော ထာဝရဘုရား၏ ကျွန်တော်အပေါင်းတို့၊ ထာဝရ ဘုရားကို ကောင်းကြီးပေးကြလော့။"
    },
    {
      "verse": 2,
      "text": "သန့်ရှင်းရာဌာနတော်သို့ လက်ကိုချီ၍၊ ထာဝရ ဘုရားကို ကောင်းကြီးပေးကြလော့။"
    },
    {
      "verse": 3,
      "text": "ကောင်းကင်နှင့် မြေကြီးကိုဖန်ဆင်းတော်မူ သော ထာဝရဘုရားသည် ဇိအုန်တောင်ပေါ်က၊ သင့်ကို ကောင်းကြီးပေးတော်မူပါ စေသော။"
    }
  ]
